# Copie ce fichier en « .env » (dans ce dossier) et remplis-le.
# Ne publie JAMAIS le fichier .env : il contient des secrets.

# Discord Developer Portal > ton application > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Le même token que celui du bot (onglet Bot)
DISCORD_BOT_TOKEN=

# Adresse publique du site. Ajoute « <cette adresse>/api/auth/retour »
# dans OAuth2 > Redirects sur le Developer Portal.
# En développement avec « npm run dev », mets l'adresse de Vite :
# DASHBOARD_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:8787
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787

# Chemin de la base du bot (par défaut : bot.db à la racine du projet)
# BOT_DB_PATH=C:\chemin\vers\bot.db

# 1 = mode démo (faux comptes, base demo.db), pour tester sans Discord
DASHBOARD_DEMO=0
